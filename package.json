{
  "name": "loomdesk-sdk",
  "version": "0.4.1",
  "description": "LoomDesk for your code: plan and build liquidity positions on Robinhood Chain, open pools on LoomDesk's hooks, send or delegate positions. Plans come back as unsigned transactions; you sign.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "smoke": "node test/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "viem": ">=2.20.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "viem": "^2.56.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/loomdesk-hq/sdk.git"
  },
  "homepage": "https://loomdesk.trade",
  "keywords": [
    "loomdesk",
    "uniswap",
    "liquidity",
    "robinhood-chain",
    "hooks",
    "memecoin",
    "sdk"
  ]
}
